rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Currículos salvos na nuvem — só o próprio usuário acessa
    match /users/{uid}/resumes/{resumeId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Registro de clientes e planos — só o backend (Admin SDK) escreve
    match /clients_registry/{uid} {
      allow read, write: if false;
    }

    // Bloqueios VIP — só o backend escreve
    match /vip_blocks/{uid} {
      allow read, write: if false;
    }

    // Depoimentos — somente o backend (Admin SDK) acessa diretamente
    match /reviews/{reviewId} {
      allow read, write: if false;
    }

    // Pagamentos anônimos — somente o backend (Admin SDK)
    match /payments_anonymous/{payId} {
      allow read, write: if false;
    }

    // Mensagens de contato — somente o backend (Admin SDK)
    match /contact_messages/{msgId} {
      allow read, write: if false;
    }
  }
}
